@model List<AkademiQMongoDb.Dtos.ProductDto.ResultProductDto>
@{
    ViewData["Title"] = "ProductList";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    int i = 0;

}

<div class="col-lg-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">Ürünler Listesi</h4>
                 
                  <div class="table-responsive pt-3">
                    <table class="table table-bordered">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Ürün Adı</th>
                          <th>Ürün Yapım Zamanı</th>
                          <th>Ürün Güncel Fiyatı</th>
                          <th>Ürün Eski Fiyatı</th>
                          <th>Ürün Görseli</th>
                          <th>Sil</th>
                          <th>Güncelle</th>
                          
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (var item in Model)
                        {
                            ++i;
                            <tr>
                                <td>@i</td>
                                <td>@item.ProductName</td>
                                <td>@item.Totaltime</td>
                                <td>@item.Price</td>
                                <td>@item.OldPrice</td>
                                <td><img src="@item.ImageUrl" style="width:150px; height:auto;" /></td>
                                <td><a href="/Product/DeleteProduct/@item.ProductId" class="btn btn-inverse-danger btn-fw">Sil</a></td>
                                <td><a href="/Product/UpdateProduct/@item.ProductId" class="btn btn-inverse-warning btn-fw">Güncelle</a></td>
                              
                            </tr>
                        }
                    </tbody>
                    </table>
                    <br /><br />
                <a href="/Product/CreateProduct/" class="btn btn-inverse-info btn-fw">Yeni Ürün Girişi</a>
                  </div>
                </div>
              </div>
            </div>

