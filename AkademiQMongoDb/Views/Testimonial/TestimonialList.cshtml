@model List<AkademiQMongoDb.Dtos.TestimonialDto.ResultTestimonialDto>
@{
    ViewData["Title"] = "TestimonialList";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    int i= 0;
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Referanslar Listesi</h4>

            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Referans Adı</th>
                            <th>Referans Mesleği</th>
                            <th>Referans Görseli</th>
                            <th>Referans Yorumu</th>
                            <th>Sil</th>
                            <th>Güncelle</th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            ++i;
                            <tr>
                                <td>@i</td>
                                <td>@item.NameSurname</td>
                                <td>@item.Pozition</td>
                                <td><img src="@item.ImageUrl" style="width:120px; height:auto;" /></td>
                                <td>@item.Description</td>
                                <td><a href="/Testimonial/DeleteTestimonial/@item.TestimonialId" class="btn btn-inverse-danger btn-fw">Sil</a></td>
                                <td><a href="/Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-inverse-warning btn-fw">Güncelle</a></td>

                            </tr>
                        }
                    </tbody>
                </table>
                <br /><br />
                <a href="/Testimonial/CreateTestimonial/" class="btn btn-inverse-info btn-fw">Yeni Referans Girişi</a>
            </div>
        </div>
    </div>
</div>

